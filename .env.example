# Neon Postgres (Vercel Marketplace integration sets this)
DATABASE_URL=

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated super admin emails (full access + team management)
SUPER_ADMIN_EMAILS=productions@madarth.com,admin@madarth.com,sikavinraj@gmail.com

# Vercel Blob (PRIVATE store). Connecting the store to the project sets ONE of these:
#  - BLOB_READ_WRITE_TOKEN (token auth), or
#  - BLOB_STORE_ID (+ VERCEL_OIDC_TOKEN, provided by Vercel / `vercel env pull`) for OIDC auth.
# The app detects which one is present at build time and uses the matching upload flow.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Zoho ZeptoMail (transactional email: thank-you, account invite, password reset)
# Mail Agents > SMTP/API > Send Mail token. With or without the "Zoho-enczapikey " prefix.
ZEPTOMAIL_TOKEN=
# Sender must be on a domain verified in ZeptoMail.
ZEPTOMAIL_FROM=noreply@madarth.com
ZEPTOMAIL_FROM_NAME=Madarth Casting
# Madarth's account is on Zoho CPaaS: https://cpaas.zoho.com/v1.1/email
# (classic ZeptoMail: https://api.zeptomail.in/v1.1/email for India, https://api.zeptomail.com/v1.1/email for .com)
ZEPTOMAIL_API_URL=https://cpaas.zoho.com/v1.1/email

# Base URL used in email links (defaults to the Vercel production URL, then http://localhost:3000)
SITE_URL=
