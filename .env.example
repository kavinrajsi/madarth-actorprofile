# Neon Postgres (Vercel Marketplace integration sets this)
DATABASE_URL=

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated super admin emails (full access + team management)
SUPER_ADMIN_EMAILS=productions@madarth.com,admin@madarth.com,sikavinraj@gmail.com

# Vercel Blob (PRIVATE store). Connecting the store to the project sets ONE of these:
#  - BLOB_READ_WRITE_TOKEN (token auth), or
#  - BLOB_STORE_ID (+ VERCEL_OIDC_TOKEN, provided by Vercel / `vercel env pull`) for OIDC auth.
# The app detects which one is present at build time and uses the matching upload flow.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
